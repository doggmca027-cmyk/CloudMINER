# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Адреси проекту для ручного поповнення (WalletTab, вкладка "Пополнение").
# Порожнє значення = у UI показується "адресу ще не налаштовано" замість фейкової адреси.
VITE_DEPOSIT_ADDRESS_TON=
VITE_DEPOSIT_ADDRESS_TRC20=

# Секрет Telegram-бота. НЕ використовується напряму у Vite-клієнті (немає
# префіксу VITE_), але все одно ніколи не комітиться — задавайте лише тут,
# у гітігнореному .env.
TELEGRAM_BOT_TOKEN=

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Адреси проекту для ручного поповнення (WalletTab, вкладка "Пополнение").
# Порожнє значення = у UI показується "адресу ще не налаштовано" замість фейкової адреси.
# VITE_DEPOSIT_ADDRESS_TON використовується для ДВОХ способів поповнення —
# нативної монети TON і токена USDT (jetton) у тій самій мережі TON,
# один і той самий гаманець, різні активи в ньому.
VITE_DEPOSIT_ADDRESS_TON=
VITE_DEPOSIT_ADDRESS_TRC20=

# Username бота без @ (напр. "cloudminer_bot") — для реферальних посилань
# виду https://t.me/<username>?start=ref_<telegramId> у FriendsTab.
VITE_TELEGRAM_BOT_USERNAME=

# Посилання/username служби підтримки (кнопка "Поддержка" в Header).
# Приймає повний https://t.me/... URL, або @username, або username без @.
VITE_SUPPORT_TELEGRAM_LINK=

# Публічне посилання на офіційний канал проєкту (1-ша обов'язкова
# підписка — TasksTab/FreeMinerCard, "Підписатись"). Порожньо = фолбек на
# захардкожений реальний канал у src/lib/subscription.ts. МУСИТЬ вести на
# той самий канал, що серверний секрет MANDATORY_CHANNEL_USERNAME нижче
# (Bot API перевіряє підписку саме там) — інакше кнопка "Підписатись"
# приведе користувача в інший канал, ніж той, який реально перевіряється.
VITE_CHANNEL_LINK=

# Публічне посилання на канал транзакцій (2-га обов'язкова підписка, поряд
# з каналом — TasksTab/FreeMinerCard). Порожньо = підписка на цей канал
# НЕ вимагається (і рядок у списку не показується) — див.
# isFullySubscribed() у src/lib/subscription.ts. Це лише посилання для UI;
# сам Bot API під час перевірки використовує серверний секрет
# TELEGRAM_TRANSACTIONS_CHANNEL_ID нижче (той самий канал).
VITE_TRANSACTIONS_CHANNEL_LINK=

# Секрет Telegram-бота. НЕ використовується напряму у Vite-клієнті (немає
# префіксу VITE_), але все одно ніколи не комітиться — задавайте лише тут,
# у гітігнореному .env.
TELEGRAM_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Секрети Edge Functions (задаються ТІЛЬКИ через `supabase secrets set ...`,
# НЕ через цей .env — Vite-клієнт їх ніколи не бачить). Перелічені тут лише
# для документації повного набору секретів проекту.
#
# check-ton-deposits / check-ton-jetton-deposits / check-tron-deposits:
#   TON_WALLET_ADDRESS, TRC20_WALLET_ADDRESS, TON_USDT_JETTON_MASTER,
#   TONAPI_KEY, TRONGRID_API_KEY, TELEGRAM_TRANSACTIONS_CHANNEL_ID
#
# process-withdrawal (автовиплата виводів після підтвердження в адмінці —
# ⚠️ приватні ключі гарячого гаманця, найчутливіші секрети проекту):
#   TON_HOT_WALLET_MNEMONIC      — 24-слівна seed-фраза TON-гаманця, з якого
#                                   платимо; має належати TON_WALLET_ADDRESS
#   TRON_HOT_WALLET_PRIVATE_KEY  — приватний ключ (hex) Tron-гаманця, з якого
#                                   платимо; має належати TRC20_WALLET_ADDRESS
#   TONCENTER_API_KEY            — опційно, для відправки TON-транзакцій
#
# check-subscription / check-subscription-retention (реальна перевірка
# підписки через Bot API getChatMember — ⚠️ бот МУСИТЬ бути доданий як
# АДМІНІСТРАТОР у КОЖЕН канал нижче, інакше Telegram відмовляє
# перевіряти довільних учасників; це стосується й майбутніх
# амбассадорських/партнерських каналів, доданих через admin_create_task):
#   MANDATORY_CHANNEL_USERNAME   — опційно, дефолт "@cloudminer_channel"
#   TELEGRAM_TRANSACTIONS_CHANNEL_ID — той самий, що вище (спільний секрет);
#                                   слугує chat_ref для перевірки 2-ї
#                                   обов'язкової підписки (канал транзакцій)
# ---------------------------------------------------------------------------

# Секрети для Edge Functions check-ton-deposits / check-ton-jetton-deposits /
# check-tron-deposits / send-notifications.
#
# Це НЕ файл Vite (`.env` у корені проєкту) — ці змінні читає Deno-рантайм
# Edge Functions і в проді вони не беруться з жодного .env-файлу, а
# задаються через:
#   supabase secrets set TON_WALLET_ADDRESS=... TRC20_WALLET_ADDRESS=... TELEGRAM_BOT_TOKEN=...
#
# Цей файл потрібен лише для локального запуску `supabase functions serve`
# (Supabase CLI підхоплює `supabase/functions/.env` автоматично).
# SUPABASE_URL і SUPABASE_SERVICE_ROLE_KEY Supabase підставляє сам —
# задавати їх вручну не треба.

# Той самий гаманець, що VITE_DEPOSIT_ADDRESS_TON у кореневому .env —
# спільний для check-ton-deposits (нативний TON) і check-ton-jetton-deposits (USDT-jetton)
TON_WALLET_ADDRESS=

# Опційно — перевизначає адресу master-контракту USDT-jetton у мережі TON.
# За замовчуванням у коді check-ton-jetton-deposits: офіційний мейннет-контракт
# (звірте самостійно на tonviewer.com перед продом).
TON_USDT_JETTON_MASTER=

# Той самий гаманець, що VITE_DEPOSIT_ADDRESS_TRC20 у кореневому .env
TRC20_WALLET_ADDRESS=

# Опційно — підвищує ліміти запитів до tonapi.io
TONAPI_KEY=

# Опційно — підвищує ліміти запитів до TronGrid
TRONGRID_API_KEY=

# Токен Telegram-бота для сповіщень користувачу про зарахований депозит
# (і про рішення адміна щодо виводу — send-notifications)
TELEGRAM_BOT_TOKEN=

# Опційно — chat_id каналу/групи транзакцій (бот має бути доданий туди адміністратором)
TELEGRAM_TRANSACTIONS_CHANNEL_ID=
